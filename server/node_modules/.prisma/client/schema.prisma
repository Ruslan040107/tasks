generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String       @unique
  passwordHash String
  avatar       String?
  bio          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  gameRecords  GameRecord[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Game {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  description   String
  thumbnail     String
  category      String
  maxPlayers    Int          @default(1)
  isMultiplayer Boolean      @default(false)
  createdAt     DateTime     @default(now())
  gameRecords   GameRecord[]

  @@map("games")
}

model GameRecord {
  id       String   @id @default(uuid())
  userId   String
  gameSlug String
  score    Int
  duration Int
  metadata Json?
  playedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameSlug], references: [slug], onDelete: Cascade)

  @@map("game_records")
}
